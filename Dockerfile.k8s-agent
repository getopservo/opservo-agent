# opservo-k8s-agent container image.
# Build (from the agent directory):  docker build -f Dockerfile.k8s-agent -t opservo-k8s-agent:dev .
# Pure-Go, CGO off, static binary on distroless — no shell, non-root.
FROM golang@sha256:9ce231b28998b32e116927c61aa5c406183061d4f3f2d61b292c88e7f6bdf7ca AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
ARG VERSION=dev
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w -X main.version=${VERSION}" -o /out/opservo-k8s-agent ./cmd/k8s-agent

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/opservo-k8s-agent /opservo-k8s-agent
USER 65532:65532
ENTRYPOINT ["/opservo-k8s-agent"]
